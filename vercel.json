{
  "version": 2,
  "installCommand": "corepack enable && corepack prepare pnpm@9.15.0 --activate && pnpm install",
  "buildCommand": "pnpm --filter frontend build",
  "rewrites": [
    {
      "source": "/api/backend/:path*",
      "destination": "https://storyforge-backend.onrender.com/api/:path*"
    }
  ]
}
