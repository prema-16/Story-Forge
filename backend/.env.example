# ============================================================
# StoryForge AI V3 — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/storyforge

# JWT (generate with: node -e "require('crypto').randomBytes(64).toString('hex')|pbcopy")
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────
# AI Providers — Text Generation
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# Set active provider (openai | anthropic | gemini | mock)
DEFAULT_TEXT_PROVIDER=openai
DEFAULT_TEXT_MODEL=gpt-4o

# ─────────────────────────────────────────────
# AI Providers — Image Generation
# ─────────────────────────────────────────────
STABILITY_AI_API_KEY=sk-...

# Set active provider (dalle | stability | mock)
DEFAULT_IMAGE_PROVIDER=dalle

# ─────────────────────────────────────────────
# AI Providers — Video Generation
# ─────────────────────────────────────────────
RUNWAY_API_KEY=key_...
KLING_API_KEY=...
PIKA_API_KEY=...
LUMA_API_KEY=...

# Set active provider (runway | kling | pika | luma | mock)
DEFAULT_VIDEO_PROVIDER=mock

# ─────────────────────────────────────────────
# AI Providers — Voice Synthesis
# ─────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_...
GOOGLE_TTS_API_KEY=...

# Set active provider (elevenlabs | openai-tts | google-tts | mock)
DEFAULT_VOICE_PROVIDER=elevenlabs

# ─────────────────────────────────────────────
# Cloudinary — Media Storage
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your-api-secret

# ─────────────────────────────────────────────
# Stripe — Billing & Payments
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER_MONTHLY=price_...
STRIPE_PRICE_STARTER_YEARLY=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# ─────────────────────────────────────────────
# YouTube — OAuth Publishing
# ─────────────────────────────────────────────
YOUTUBE_CLIENT_ID=...apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=GOCSPX-...
YOUTUBE_REDIRECT_URI=http://localhost:5000/api/youtube/callback

# ─────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────
ENABLE_MOCK_AI=false
ENABLE_BILLING=true
ENABLE_PLUGIN_SYSTEM=true

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────
LOG_LEVEL=info
