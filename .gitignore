# StoryForge AI

node_modules/

# Environment files — NEVER commit real secrets
.env
.env.local
.env.development
.env.staging
.env.production
.env.*.local
# Allow example/template files
!.env*.example

dist/
build/
.next/
*.log
.DS_Store
coverage/
.turbo/

# Compiled JS artifacts from source (packages build to dist/, not src/)
packages/*/src/**/*.js
packages/*/src/**/*.js.map
frontend/src/__tests__/**/*.js
frontend/src/__tests__/**/*.js.map
